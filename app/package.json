{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:engine": "tsx --tsconfig tsconfig.json scripts/test-engine.mjs",
    "test:upload": "tsx --tsconfig tsconfig.json scripts/test-upload-e2e.mjs",
    "test:accuracy": "node scripts/test-accuracy.mjs",
    "postinstall": "node scripts/copy-runtime-assets.mjs",
    "cf:build": "FFMPEG_FROM_CDN=1 opennextjs-cloudflare build && node scripts/cf-check-assets.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "@paper-design/shaders-react": "^0.0.82",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "diff": "^9.0.0",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.77.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "motion": "^14.5.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "piexifjs": "^1.0.6",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "image-size": "^2.1.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "UNLICENSED"
}
