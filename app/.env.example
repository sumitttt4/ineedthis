# Canonical URL for metadata / Open Graph / sitemap (defaults to https://ineedthis.site in production)
NEXT_PUBLIC_SITE_URL=https://ineedthis.site

# Optional TURN relay for P2P transfer behind strict NATs (comma-separate multiple URLs)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
